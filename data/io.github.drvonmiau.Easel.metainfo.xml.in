<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>io.github.drvonmiau.Easel</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>
	<name>Easel</name>
	<summary>Browse your local photos</summary>
	<developer id="io.github.drvonmiau">
		<name>Daniel</name>
	</developer>
	<description>
	  <p>
	    Easel is a calm, focused gallery for the photos you already have on
	    disk. Browse everything at once or by album, keep favourites, and open
	    any picture full-screen — all without an account or a cloud service.
	  </p>
	  <p>Features:</p>
	  <ul>
	    <li>A clean grid of every photo, or grouped into albums by folder</li>
	    <li>A full-window lightbox with left/right navigation</li>
	    <li>Favourites, kept apart in their own view</li>
	    <li>Folder watching, light and dark themes</li>
	  </ul>
	</description>
	<launchable type="desktop-id">io.github.drvonmiau.Easel.desktop</launchable>
	<content_rating type="oars-1.1"/>
	<branding>
		<color type="primary" scheme_preference="light">#dfe3f5</color>
		<color type="primary" scheme_preference="dark">#2b3145</color>
	</branding>
	<url type="homepage">https://github.com/DrVonMiau/easel</url>
	<url type="bugtracker">https://github.com/DrVonMiau/easel/issues</url>
	<url type="vcs-browser">https://github.com/DrVonMiau/easel</url>
	<screenshots>
		<screenshot type="default">
			<image>https://raw.githubusercontent.com/DrVonMiau/easel/main/data/screenshots/gallery.png</image>
			<caption>Every photo on a clean paper card</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/DrVonMiau/easel/main/data/screenshots/details.png</image>
			<caption>A photo with its details panel</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/DrVonMiau/easel/main/data/screenshots/editor.png</image>
			<caption>The non-destructive editor</caption>
		</screenshot>
	</screenshots>
	<requires>
		<display_length compare="ge">768</display_length>
	</requires>
	<supports>
		<control>keyboard</control>
		<control>pointing</control>
	</supports>
	<releases>
		<release version="1.0.0" date="2026-08-31">
			<description>
				<p>Easel reaches 1.0 — its first stable release.</p>
				<ul>
					<li>Consistent grids and spacing across every view, with square tiles that line up</li>
					<li>Thumbnails load once and stay put; steadier scrolling in large folders</li>
					<li>Window chrome now follows your system icon theme</li>
					<li>Refreshed screenshots and documentation</li>
				</ul>
			</description>
		</release>
		<release version="0.4.0" date="2026-08-09">
			<description>
				<p>Folders, and a calmer, faster library.</p>
				<ul>
					<li>Browse by folder: the new Folders view mirrors the folders on your disk, and opening one shows its sub-folders and photos — Easel reads your folders in place and never moves or imports anything</li>
					<li>Streamlined views: All photos, Folders, Albums, People and Map</li>
					<li>Favourites and Hidden are pinned albums; hide a photo to tuck it away, or move it to the system Trash from the menu</li>
					<li>Video thumbnails, and smoother playback</li>
					<li>A more detailed offline map with major rivers, roads and cities</li>
					<li>Faster loading and scrolling for large libraries, with progress while a folder is scanned</li>
				</ul>
			</description>
		</release>
		<release version="0.3.0" date="2026-07-28">
			<description>
				<p>Places and people.</p>
				<ul>
					<li>A Map view that places your photos by the GPS location in their metadata, on a zoomable offline world map (land, lakes and country borders) — no network needed</li>
					<li>Photos from the same place gather into one pin with a count; click it to open them all</li>
					<li>People: tag someone by name right on a photo, then browse every photo they're in</li>
				</ul>
			</description>
		</release>
		<release version="0.2.0" date="2026-07-28">
			<description>
				<p>Editing and importing arrive.</p>
				<ul>
					<li>A photo editor: brightness, contrast, saturation, exposure and temperature, with a preset filter set (B&amp;W, Sepia, Warm, Cool, Vivid, Fade, Noir)</li>
					<li>An interactive crop tool with aspect-ratio presets and a straighten slider</li>
					<li>Rotate and flip, saved as a lossless copy that keeps the original's date and other metadata</li>
					<li>Import individual photos, and drag-and-drop files or folders onto the window</li>
				</ul>
			</description>
		</release>
		<release version="0.1.0" date="2026-07-21">
			<description>
				<p>Initial release of Easel — the tool of each art, recast for photos. Browse your local pictures on a clean paper card, group them into albums, keep favourites, and open any photo in a full-window lightbox.</p>
			</description>
		</release>
	</releases>
</component>
